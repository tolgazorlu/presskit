# Copy to .env and fill in only what you use. Empty values disable that
# integration entirely. These end up in the public bundle: use a Firebase Web
# API key restricted to your domain (Google Cloud Console > Credentials).

# Microsoft Clarity project ID (https://clarity.microsoft.com)
VITE_CLARITY_ID=

# Firebase Analytics (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
